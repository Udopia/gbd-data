CREATE TRIGGER local_hash AFTER INSERT ON local
                                    BEGIN INSERT OR IGNORE INTO features (hash) VALUES (NEW.hash); END;
CREATE TRIGGER filename_hash AFTER INSERT ON filename
                                    BEGIN INSERT OR IGNORE INTO features (hash) VALUES (NEW.hash); END;
CREATE TRIGGER setid_hash AFTER INSERT ON setid
                                    BEGIN INSERT OR IGNORE INTO features (hash) VALUES (NEW.hash); END;
COMMIT;
